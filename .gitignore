# Build output
/bin/
/dist/
# web/dist is embedded into the binary; the placeholder keeps `go build` working before `npm run build`
web/dist/*
!web/dist/.gitkeep
/*.test
/*.out
/coverage.*

# Load test outputs
/.runs/

# The player's workspaces (the three saves of the menu, ADR-0025)
/workspace/
/workspace-2/
/workspace-3/

# Dependencies
node_modules/
web/node_modules/

# Local env and secrets (never commit)
.env
.env.*
!.env.example

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
.DS_Store

# Logs
*.log
