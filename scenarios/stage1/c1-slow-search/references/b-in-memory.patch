diff --color -ruN a/internal/store/searchindex.go b/internal/store/searchindex.go
--- a/internal/store/searchindex.go	1969-12-31 21:00:00.000000000 -0300
+++ b/internal/store/searchindex.go	2026-09-25 01:14:37.038008949 -0300
@@ -0,0 +1,77 @@
+package store
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"strings"
+	"sync/atomic"
+	"time"
+)
+
+// searchIndex is an in-memory copy of the catalog, newest first, so search
+// never touches the database. Trade-off: results may be up to one refresh
+// interval stale (new products, stock), and every instance holds a copy.
+type searchIndex struct {
+	products []Product // sorted by created_at DESC
+	lower    []string  // lower-cased names, same order
+}
+
+var index atomic.Pointer[searchIndex]
+
+// StartSearchIndex loads the catalog and refreshes it every interval until ctx ends.
+func (s *Store) StartSearchIndex(ctx context.Context, interval time.Duration, log *slog.Logger) error {
+	if err := s.loadSearchIndex(ctx); err != nil {
+		return err
+	}
+	go func() {
+		t := time.NewTicker(interval)
+		defer t.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-t.C:
+				if err := s.loadSearchIndex(ctx); err != nil && ctx.Err() == nil {
+					log.Warn("search index refresh failed; serving the previous copy", "err", err)
+				}
+			}
+		}
+	}()
+	return nil
+}
+
+func (s *Store) loadSearchIndex(ctx context.Context) error {
+	rows, err := s.pool.Query(ctx, `
+		SELECT id, sku, name, category, price_cents, stock, created_at
+		FROM products
+		ORDER BY created_at DESC`)
+	if err != nil {
+		return fmt.Errorf("load search index: %w", err)
+	}
+	products, err := collectProducts(rows)
+	if err != nil {
+		return err
+	}
+	idx := &searchIndex{products: products, lower: make([]string, len(products))}
+	for i, p := range products {
+		idx.lower[i] = strings.ToLower(p.Name)
+	}
+	index.Store(idx)
+	return nil
+}
+
+func searchInMemory(term string, limit int) []Product {
+	idx := index.Load()
+	q := strings.ToLower(term)
+	out := make([]Product, 0, limit)
+	for i, name := range idx.lower {
+		if strings.Contains(name, q) {
+			out = append(out, idx.products[i])
+			if len(out) == limit {
+				break
+			}
+		}
+	}
+	return out
+}
