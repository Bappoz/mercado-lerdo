diff --git c/internal/store/searchindex.go i/internal/store/searchindex.go
new file mode 100644
index 0000000..6378a63
--- /dev/null
+++ i/internal/store/searchindex.go
@@ -0,0 +1,77 @@
+package store
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"strings"
+	"sync/atomic"
+	"time"
+)
+
+// searchIndex é uma cópia do catálogo em memória, mais novos primeiro, para a
+// busca nunca ir ao banco. Custo: os resultados podem estar até um intervalo de
+// atualização atrasados (produtos novos, estoque), e cada instância guarda uma cópia.
+type searchIndex struct {
+	products []Product // ordenados por created_at DESC
+	lower    []string  // nomes em minúsculas, na mesma ordem
+}
+
+var index atomic.Pointer[searchIndex]
+
+// StartSearchIndex carrega o catálogo e o atualiza a cada interval até ctx acabar.
+func (s *Store) StartSearchIndex(ctx context.Context, interval time.Duration, log *slog.Logger) error {
+	if err := s.loadSearchIndex(ctx); err != nil {
+		return err
+	}
+	go func() {
+		t := time.NewTicker(interval)
+		defer t.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-t.C:
+				if err := s.loadSearchIndex(ctx); err != nil && ctx.Err() == nil {
+					log.Warn("falha ao atualizar o índice de busca; servindo a cópia anterior", "err", err)
+				}
+			}
+		}
+	}()
+	return nil
+}
+
+func (s *Store) loadSearchIndex(ctx context.Context) error {
+	rows, err := s.pool.Query(ctx, `
+		SELECT id, sku, name, category, price_cents, stock, created_at
+		FROM products
+		ORDER BY created_at DESC`)
+	if err != nil {
+		return fmt.Errorf("carregar o índice de busca: %w", err)
+	}
+	products, err := collectProducts(rows)
+	if err != nil {
+		return err
+	}
+	idx := &searchIndex{products: products, lower: make([]string, len(products))}
+	for i, p := range products {
+		idx.lower[i] = strings.ToLower(p.Name)
+	}
+	index.Store(idx)
+	return nil
+}
+
+func searchInMemory(term string, limit int) []Product {
+	idx := index.Load()
+	q := strings.ToLower(term)
+	out := make([]Product, 0, limit)
+	for i, name := range idx.lower {
+		if strings.Contains(name, q) {
+			out = append(out, idx.products[i])
+			if len(out) == limit {
+				break
+			}
+		}
+	}
+	return out
+}
