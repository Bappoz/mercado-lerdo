+// release gives the stock of an unpaid order back and marks it failed.
+func (s *Store) release(ctx context.Context, orderID int64, items []Item) error {
+	tx, err := s.pool.Begin(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback(ctx) //nolint:errcheck // no-op after commit
+	for _, it := range items {
+		if _, err := tx.Exec(ctx, `UPDATE products SET stock = stock + $1 WHERE id = $2`, it.Quantity, it.ProductID); err != nil {
+			return err
+		}
+	}
+	if _, err := tx.Exec(ctx, `UPDATE orders SET status = 'failed' WHERE id = $1`, orderID); err != nil {
+		return err
+	}
+	return tx.Commit(ctx)
+}
