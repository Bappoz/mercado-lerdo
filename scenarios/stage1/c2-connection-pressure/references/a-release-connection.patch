 func (s *Store) PlaceOrder(ctx context.Context, userID int64, orderRef string, items []Item, charge ChargeFunc) (Order, error) {
+	o, err := s.reserve(ctx, userID, orderRef, items)
+	if err != nil {
+		return Order{}, err
+	}
+	// Once the gateway is asked, the outcome must be recorded even if the
+	// client stops waiting: otherwise the customer pays for nothing.
+	ctx = context.WithoutCancel(ctx)
+	if err := charge(ctx, orderRef, o.TotalCents); err != nil {
+		if rerr := s.release(ctx, o.ID, items); rerr != nil {
+			return Order{}, fmt.Errorf("charge: %w (and releasing the order failed: %v)", err, rerr)
+		}
+		return Order{}, fmt.Errorf("charge: %w", err)
+	}
+	if _, err := s.pool.Exec(ctx, `UPDATE orders SET status = 'paid' WHERE id = $1`, o.ID); err != nil {
+		return Order{}, fmt.Errorf("mark order paid: %w", err)
+	}
+	o.Status = "paid"
+	return o, nil
+}
