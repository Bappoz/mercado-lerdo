-// PlaceOrder reserva o estoque, cobra o cliente e grava o pedido.
+// PlaceOrder reserva o estoque, grava o pedido como pendente, cobra o cliente
+// e marca o pedido como pago. Nenhuma conexão com o banco fica presa enquanto
+// o gateway responde: a cobrança acontece entre duas transações curtas.
 func (s *Store) PlaceOrder(ctx context.Context, userID int64, orderRef string, items []Item, charge ChargeFunc) (Order, error) {
+	o, err := s.reserve(ctx, userID, orderRef, items)
+	if err != nil {
+		return Order{}, err
+	}
+	// Depois de chamar o gateway, o resultado precisa ser gravado mesmo que o
+	// cliente desista de esperar: senão o cliente paga por nada.
+	ctx = context.WithoutCancel(ctx)
+	if err := charge(ctx, orderRef, o.TotalCents); err != nil {
+		if rerr := s.release(ctx, o.ID, items); rerr != nil {
+			return Order{}, fmt.Errorf("cobrança: %w (e liberar o pedido também falhou: %v)", err, rerr)
+		}
+		return Order{}, fmt.Errorf("cobrança: %w", err)
+	}
+	if _, err := s.pool.Exec(ctx, `UPDATE orders SET status = 'paid' WHERE id = $1`, o.ID); err != nil {
+		return Order{}, fmt.Errorf("marcar o pedido como pago: %w", err)
+	}
+	o.Status = "paid"
+	return o, nil
+}
